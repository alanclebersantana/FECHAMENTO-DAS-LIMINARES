rules_version = '2';

// ============================================================
//  Central Milhas Plus — regras do Firestore
//
//  Princípio: o administrador enxerga tudo. O parceiro enxerga
//  apenas os documentos que carregam o e-mail dele no campo
//  respEmail, e nunca as coleções que contêm custo.
//
//  O app grava respEmail em contas, lançamentos e pagamentos a
//  cada sincronização, então a comparação abaixo é direta e não
//  precisa de leituras extras (que seriam cobradas).
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- auxiliares ----------
    function logado() {
      return request.auth != null;
    }

    function admin() {
      return logado() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function meuEmail() {
      return logado() ? request.auth.token.email.lower() : '';
    }

    // o documento pertence a quem está pedindo
    function meu() {
      return logado()
        && resource.data.respEmail != null
        && resource.data.respEmail != ''
        && resource.data.respEmail == meuEmail();
    }

    // ---------- quem é administrador ----------
    // Crie o primeiro documento pelo console:  admins/<UID>  { }
    // Ninguém consegue se promover pelo app.
    match /admins/{uid} {
      allow read:  if logado() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------- parceiros ----------
    // O parceiro lê e lista apenas o próprio cadastro.
    // No 1º acesso, pode gravar o próprio e-mail no cadastro que
    // ainda está vago — e nada além disso.
    match /parceiros/{id} {
      allow read: if admin()
                  || (logado() && resource.data.email == meuEmail());

      allow create, delete: if admin();

      allow update: if admin()
        || (
          logado()
          && (resource.data.email == '' || resource.data.email == null)
          && request.resource.data.email == meuEmail()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email'])
        );
    }

    // ---------- contas ----------
    match /contas/{id} {
      allow read:  if admin() || meu();
      allow write: if admin();
    }

    // ---------- lançamentos ----------
    // Sem campos de custo: o parceiro vê milhas, valor e resultado.
    match /lancamentos/{id} {
      allow read:  if admin() || meu();
      allow write: if admin();
    }

    // ---------- custo por lançamento ----------
    // Fica separado justamente para poder ser negado ao parceiro.
    match /custos/{id} {
      allow read, write: if admin();
    }

    // ---------- operações ----------
    // Contém custo total e CPM de custo: administrador apenas.
    match /operacoes/{id} {
      allow read, write: if admin();
    }

    // ---------- pagamentos ----------
    match /pagamentos/{id} {
      allow read:  if admin() || meu();
      allow write: if admin();
    }

    // ---------- configuração compartilhada ----------
    // Companhias, fornecedores e preferências do relatório.
    // Qualquer usuário autenticado lê; só o administrador grava.
    match /config/{doc} {
      allow read:  if logado();
      allow write: if admin();
    }

    // ---------- convites ----------
    // Mapeia o código enviado ao parceiro para o cadastro dele.
    // Leitura só por id exato (nunca listagem), para que ninguém
    // consiga varrer os códigos existentes.
    match /convites/{codigo} {
      allow get:    if logado();
      allow list:   if admin();
      allow write:  if admin();
    }

    // ---------- porta fechada ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
